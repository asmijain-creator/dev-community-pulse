# Copy to .env for local runs. On Vercel, add these under Project -> Settings -> Environment Variables.

# Required
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Security
CRON_SECRET=                 # any long random string; Vercel Cron sends it automatically
ADMIN_PASSWORD=              # protects /topics and the Run now button (any username works)

# Email (optional, but needed for the Friday email)
RESEND_API_KEY=
DIGEST_EMAIL_TO=             # comma-separated; with onboarding@resend.dev only your own Resend email works
DIGEST_EMAIL_FROM=Community Pulse <onboarding@resend.dev>

# Optional: higher API rate limits
GITHUB_TOKEN=                # fine-grained token with no permissions is enough for public search
STACKEXCHANGE_KEY=           # free key from stackapps.com raises the daily quota 300 -> 10,000

# Optional tuning
GEMINI_MODEL=gemini-2.5-flash
APP_URL=                     # dashboard link in the email; auto-detected on Vercel
LOOKBACK_DAYS=7
MAX_POSTS_PER_QUERY=15
MAX_CLASSIFY_PER_RUN=240
CLASSIFY_BATCH_SIZE=30
