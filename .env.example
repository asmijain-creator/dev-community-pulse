# Required
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=generate-a-long-random-string

# Email (required for Friday delivery; dashboard works without it)
RESEND_API_KEY=
DIGEST_EMAIL_TO=
# Use onboarding@resend.dev for self-only testing (sends only to the Resend account owner).
# For other recipients, verify your domain in Resend and set e.g. briefs@yourdomain.com.
RESEND_FROM=onboarding@resend.dev

# Optional — raise rate limits
GITHUB_TOKEN=
SO_KEY=
